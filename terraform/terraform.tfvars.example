# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# AWS credentials are NOT set here - use `aws configure` / AWS_PROFILE / SSO.

aws_region          = "ap-south-1"
project             = "stockpilot"
environment         = "dev"
cluster_version     = "1.34"
vpc_cidr            = "10.30.0.0/16"
node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND" # or "SPOT" to save money
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4
