# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# AWS credentials are NOT set here - use `aws configure` / AWS_PROFILE / SSO.

aws_region          = "ap-southeast-2"
project             = "stockpilot"
environment         = "dev"
cluster_version     = "1.34"
vpc_cidr            = "10.30.0.0/16"
node_instance_types = ["c7i-flex.large"] # must be Free Tier eligible on Free-plan accounts
node_capacity_type  = "ON_DEMAND" # "SPOT" is cheaper but blocked on AWS Free-plan accounts
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4
